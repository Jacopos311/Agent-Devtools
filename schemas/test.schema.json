{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "fixture_path": { "type": "string" },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["event_present", "event_absent", "context_block_present", "prompt_contains", "tool_called", "tool_not_called"] },
          "event_type": { "type": "string" },
          "payload_match": { "type": "object" },
          "block_name": { "type": "string" },
          "contains": { "type": "string" },
          "text": { "type": "string" },
          "tool_name": { "type": "string" }
        },
        "required": ["type"]
      }
    }
  },
  "required": ["name", "assertions"]
}